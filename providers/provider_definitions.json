    },
    "config_version" : 2,
    "id" : "files-f260f07b-c9ee-405a-bea6-e4ed1907d475",
    "name" : "construct_examples",
    "specId" : "files",
    "streams" : [
      {
        "columns" : [

        ],
        "description" : "App event JSON lines: ts is the event time, ctx is split into ctx_region \/ ctx_version.",
        "dynamicSchema" : true,
        "format" : "ndjson",
        "globalTimeField" : "ts",
        "id" : "app_events",
        "method" : "GET",
        "name" : "App events",
        "path" : "\/events",
        "transforms" : [
          {
            "unwrap" : {
              "field" : "_raw"
            }
          },
          {
            "lift" : {
              "path" : [
                "_raw"
              ]
            }
          },
          {
            "flatten" : {
              "depth" : 2
            }
          },
          {
            "parseTime" : {
              "field" : "ts",
              "format" : "iso8601"
            }
          },
          {
            "coerceTypes" : {
              "fields" : {
                "latency_ms" : "integer",
                "ts_ms" : "integer"
              }
            }
          }
        ],
        "userParams" : [
          {
            "default" : "app\/*.jsonl",
            "key" : "path",
            "label" : "Files",
            "location" : "query",
            "required" : false
          },
          {
            "key" : "earliest",
            "label" : "Earliest",
            "location" : "query",
            "required" : false,
            "role" : "timeStart",
            "time" : {
              "format" : "epoch_seconds"
            }
          },
          {
            "key" : "latest",
            "label" : "Latest",
            "location" : "query",
            "required" : false,
            "role" : "timeEnd",
            "time" : {
              "format" : "epoch_seconds"
            }
          },
          {
            "default" : "{{config.root_max_files}}",
            "key" : "max_files",
            "label" : "Max files",
            "location" : "query",
            "required" : false,
            "role" : "limit"
          },
          {
            "default" : "{{config.root_tail_bytes}}",
            "key" : "tail_bytes",
            "label" : "Max bytes read",
            "location" : "query",
            "required" : false,
            "role" : "limit"
          },
          {
            "default" : "{{config.root_max_events}}",
            "key" : "max_events",
            "label" : "Max events",
            "location" : "query",
            "required" : false,
            "role" : "limit"
          },
          {
            "default" : "{{config.root_max_follow_files}}",
            "key" : "max_follow_files",
            "label" : "Max files followed (real time)",
            "location" : "query",
            "required" : false,
            "role" : "limit"
          },
          {
            "default" : "65536",
            "key" : "max_event_bytes",
            "label" : "Max bytes per event",
            "location" : "query",
            "required" : false,
            "role" : "limit"
          }
        ]
      }
    ],
    "type" : "custom"
