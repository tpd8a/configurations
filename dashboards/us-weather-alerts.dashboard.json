      "query" : {
        "name" : "Active Alerts Table",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT headline, event, severity, category, urgency, affectedZones FROM weather_gov_api.alerts_query WHERE status = 'Actual' ORDER BY effective DESC LIMIT 50"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_bc5a618c9c374d69a8c919a13d43b3f6",
      "query" : {
        "name" : "Alerts by Severity",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT severity, COUNT(*) as alert_count FROM weather_gov_api.alerts_query WHERE status = 'Actual' GROUP BY severity ORDER BY alert_count DESC"
        },
        "type" : "ds.sql"
      }
    }
