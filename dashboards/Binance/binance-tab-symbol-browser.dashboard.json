        "query" : {
          "method" : "GET"
        },
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT symbol, priceChange, priceChangePercent, close FROM binance_spot.ws_ticker WHERE symbol = '$symbol_tok$'"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_7da3c4410f3a042110bbe72116145dc3",
      "query" : {
        "name" : "viz_klines",
        "query" : {
          "method" : "GET",
          "parameters" : {
            "tql" : "ta bollinger(close, 20, 2) as sma20"
          }
        },
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT * FROM binance_spot.klines(symbol:='$symbol_tok$',startTime:='$earliest$', endTime:='$latest$',interval:='5m') ORDER BY time DESC\n"
        },
        "time_mode" : {
          "earliest" : "$input2.earliest$",
          "latest" : "$input2.latest$",
          "mode" : "fixed"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_992a2f1ae09e4cee822b6a69b436f50d",
      "query" : {
        "name" : "viz_klines_ws",
        "query" : {
          "method" : "GET"
        },
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT * FROM binance_spot.ws_kline(symbol:='$symbol_tok$',startTime:='$earliest$', endTime:='$latest$',interval:='1m')\n"
        },
        "type" : "ds.sql"
      }
    },
    {
