  "data_sources" : [
    {
      "id" : "ds_69facdffb1b5485d940987d05f84bfd7",
      "query" : {
        "name" : "Glossary Alerts",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT term, definition FROM weather.glossary ORDER BY term LIMIT 100"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_2dee83a17b7b4e25a1f36d4f8876a54c",
      "query" : {
        "name" : "Total Alerts Count",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT COUNT(*) as total_alerts FROM weather.glossary"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_ba42637cfe5f4013972494103c71efd0",
      "query" : {
        "name" : "Alerts by Severity",
        "query" : {
          "method" : "GET"
        },
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT \n  (SUM(term LIKE '%hurricane%' OR definition LIKE '%hurricane%') +\n   SUM(term LIKE '%tornado%' OR definition LIKE '%tornado%') +\n   SUM(term LIKE '%blizzard%' OR definition LIKE '%blizzard%')) as severe,\n  (SUM(term LIKE '%thunderstorm%' OR definition LIKE '%thunderstorm%') +\n   SUM(term LIKE '%rain%' OR definition LIKE '%rain%')) as moderate,\n  (SUM(term LIKE '%cloudy%' OR definition LIKE '%cloudy%') +\n   SUM(term LIKE '%fog%' OR definition LIKE '%fog%')) as mild\nFROM weather.glossary"
        },
        "type" : "ds.sql"
      }
    }
  ],
