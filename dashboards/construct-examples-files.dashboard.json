        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT ts, user, action, latency_ms, ctx_region FROM construct_examples.app_events() WHERE level = 'ERROR' ORDER BY ts DESC LIMIT 50"
        },
        "type" : "ds.sql"
      }
    },
