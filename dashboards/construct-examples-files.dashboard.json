        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT action, COUNT(*) AS events, AVG(latency_ms) AS avg_ms, MAX(latency_ms) AS max_ms FROM construct_examples.app_events() GROUP BY action ORDER BY events DESC"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_0d1a3b841a4d4801bdae269a4fe2b343",
