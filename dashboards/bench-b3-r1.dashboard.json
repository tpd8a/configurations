      "id" : "ds_a1c4e7f02b3d4e5f8a9b0c1d2e3f4a51",
      "query" : {
        "name" : "actions_by_user",
        "refresh_seconds" : 300,
        "sql" : {
          "query" : "SELECT user, action, COUNT(*) AS events FROM construct_examples.jsonl(path := 'bench\/events.jsonl') GROUP BY user, action ORDER BY user"
        },
        "time_mode" : {
          "mode" : "none"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_b2d5f8a13c4e4f60a9b1c2d3e4f5a6b2",
      "query" : {
        "name" : "user_events",
        "refresh_seconds" : 300,
        "sql" : {
          "query" : "SELECT ts, user, action, level, latency_ms FROM construct_examples.jsonl(path := 'bench\/events.jsonl') WHERE user = '$user$' ORDER BY latency_ms DESC"
        },
        "time_mode" : {
          "mode" : "none"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_c3e6a9b24d5f4a71b0c2d3e4f5a6b7c3",
      "query" : {
        "name" : "user_choices",
        "refresh_seconds" : 300,
        "sql" : {
          "query" : "SELECT DISTINCT user FROM construct_examples.jsonl(path := 'bench\/events.jsonl') ORDER BY user"
        },
        "time_mode" : {
          "mode" : "none"
        },
        "type" : "ds.sql"
      }
    }
  ],
