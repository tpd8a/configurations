{
  "absolute_geometry_version" : 1,
  "config_version" : 2,
  "data_sources" : [
    {
      "id" : "ds_5a6e0000d0c0000000000b0000000040",
      "query" : {
        "name" : "Providers",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT id AS value, name AS label FROM construct_providers ORDER BY name COLLATE NOCASE"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5a6e0000d0c0000000000b0000000041",
      "query" : {
        "name" : "Provider header",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT '## ' || name || char(10) || char(10) || connector || COALESCE(' · version ' || connector_version, '') || '  ·  ' || status_text AS md FROM construct_providers WHERE id = '$provider_id$'"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5a6e0000d0c0000000000b0000000042",
      "query" : {
        "name" : "Provider is the repository",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT 1 AS repository FROM construct_providers WHERE id = '$provider_id$' AND repository = 1"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5a6e0000d0c0000000000b0000000043",
      "query" : {
        "name" : "Provider tabs",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT value, label, icon FROM (SELECT 1 AS ord, 'files' AS value, 'Files' AS label, 'doc.on.doc' AS icon FROM construct_providers WHERE id = '$provider_id$' AND repository = 1 UNION ALL SELECT 2 AS ord, 'streams' AS value, 'Streams' AS label, 'list.bullet.rectangle' AS icon FROM construct_providers WHERE id = '$provider_id$' AND EXISTS (SELECT 1 FROM construct_streams WHERE provider = '$provider_id$') UNION ALL SELECT 3 AS ord, 'history' AS value, 'History' AS label, 'clock.arrow.circlepath' AS icon FROM construct_providers WHERE id = '$provider_id$' AND repository = 1 UNION ALL SELECT 4 AS ord, 'authentication' AS value, 'Authentication' AS label, 'key' AS icon FROM construct_providers WHERE id = '$provider_id$' UNION ALL SELECT 5 AS ord, 'settings' AS value, 'Settings' AS label, 'gearshape' AS icon FROM construct_providers WHERE id = '$provider_id$') ORDER BY ord"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5a6e0000d0c0000000000b0000000044",
      "query" : {
        "name" : "Provider enabled",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT CASE WHEN enabled = 1 THEN 'true' ELSE 'false' END AS value FROM construct_providers WHERE id = '$provider_id$'"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5a6e0000d0c0000000000b0000000045",
      "query" : {
        "name" : "Repository status",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT '**' || branch || '**  ·  ' || status_text AS md FROM construct_repo_status"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5a6e0000d0c0000000000b0000000046",
      "query" : {
        "name" : "Branches",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT name FROM construct_repo_branches ORDER BY current DESC, name"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5a6e0000d0c0000000000b0000000047",
      "query" : {
        "name" : "Repository has changes",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT changed_count FROM construct_repo_status WHERE changed_count > 0 AND first_connect = ''"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5a6e0000d0c0000000000b0000000048",
      "query" : {
        "name" : "Files",
        "query" : {
          "method" : "GET"
        },
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT *, open_kind <> 'none' AS openable, state IN ('localChanges', 'untracked', 'deletedLocally') AS committable, CASE state WHEN 'localChanges' THEN 'Modified' WHEN 'untracked' THEN 'New' WHEN 'deletedLocally' THEN 'Deleted' WHEN 'stale' THEN 'Behind' ELSE NULL END AS state_label FROM construct_repo_files"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5a6e0000d0c0000000000b0000000049",
      "query" : {
        "name" : "File history",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT * FROM construct_repo_history WHERE path = '$row.path$'"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5a6e0000d0c0000000000b000000004a",
      "query" : {
        "name" : "History",
        "query" : {
          "method" : "GET"
        },
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT *, by_line || ' · ' || COALESCE(device || ' · ', '') || strftime('%Y-%m-%d %H:%M', date, 'unixepoch') || ' · ' || short_sha AS meta FROM construct_repo_history"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5a6e0000d0c0000000000b000000004b",
      "query" : {
        "name" : "Provider settings",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT '**Endpoint**  ' || COALESCE(endpoint, '—') || char(10) || char(10) || '**Connector**  ' || connector || COALESCE(' · version ' || connector_version, '') || char(10) || char(10) || '**Enabled**  ' || CASE WHEN enabled = 1 THEN 'Yes' ELSE 'No' END || char(10) || char(10) || '**Status**  ' || status_text || char(10) || char(10) || '_Provider settings are edited in Settings → Providers._' AS md FROM construct_providers WHERE id = '$provider_id$'"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5a6e0000d0c0000000000b000000004c",
      "query" : {
        "name" : "Provider authentication",
        "query" : {
          "method" : "GET"
        },
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT '**Auth type**  ' || auth_type || char(10) || char(10) || '**Credential**  ' || CASE WHEN has_credential = 1 THEN '✓ present on this device' ELSE '✗ missing' END || char(10) || char(10) || '_Credentials are edited in Settings → Providers._' AS md FROM construct_providers WHERE id = '$provider_id$'"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5a6e0000d0c0000000000b0000000060",
      "query" : {
        "name" : "Repository accepts writes",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT 1 AS writable FROM construct_repo_status WHERE first_connect = ''"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5a6e0000d0c0000000000b0000000061",
      "query" : {
        "name" : "First connect notice",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT CASE first_connect WHEN 'pending' THEN '**Not synced — choose how to connect.** Save, Get latest and Undo all are off until you choose.' ELSE '**Couldn''t check the repository.** Save, Get latest and Undo all are off until it can be checked.' END AS md FROM construct_repo_status WHERE first_connect <> ''"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5a6e0000d0c0000000000b0000000062",
      "query" : {
        "name" : "First connect pending",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT 1 AS state FROM construct_repo_status WHERE first_connect = 'pending'"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5a6e0000d0c0000000000b0000000063",
      "query" : {
        "name" : "First connect check failed",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT 1 AS state FROM construct_repo_status WHERE first_connect = 'check_failed'"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5ec7105e0d5c0000000000a000000047",
      "query" : {
        "name" : "Browse flows",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT *, 'by ' || COALESCE(parent_name, parent) AS browse_hint FROM construct_streams WHERE provider = '$provider_id$' AND browse_flow = 1 ORDER BY name COLLATE NOCASE"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5ec7105e0d5c0000000000a000000048",
      "query" : {
        "description" : "The selected browse flow's parent rows (the picker's choices).",
        "name" : "Browse parents",
        "refresh_seconds" : 0,
        "run_when" : [
          "browse",
          "browse.parent_key=~\\A(?!(?i:AND|ARRAY|AS|ASC|BETWEEN|BY|CROSS|DESC|DISTINCT|FALSE|FROM|GROUP|HAVING|IN|INNER|IS|JOIN|LATERAL|LEFT|LIKE|LIMIT|NOT|NULL|OFFSET|ON|OR|ORDER|RIGHT|SELECT|TRUE|WHERE)\\z)[A-Za-z_][A-Za-z0-9_]*\\z",
          "browse.parent_label_field=~\\A(?!(?i:AND|ARRAY|AS|ASC|BETWEEN|BY|CROSS|DESC|DISTINCT|FALSE|FROM|GROUP|HAVING|IN|INNER|IS|JOIN|LATERAL|LEFT|LIKE|LIMIT|NOT|NULL|OFFSET|ON|OR|ORDER|RIGHT|SELECT|TRUE|WHERE)\\z)[A-Za-z_][A-Za-z0-9_]*\\z"
        ],
        "sql" : {
          "query" : "SELECT '$browse.parent_root_value$' AS value, '$browse.parent_root_label$' AS label WHERE '$browse.parent_root_value$' <> '' UNION ALL SELECT $browse.parent_key$ AS value, coalesce($browse.parent_label_field$, $browse.parent_key$) AS label FROM construct_stream_rows(provider := '$provider_id$', stream := '$browse.parent$', args := '{}')"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5ec7105e0d5c0000000000a000000049",
      "query" : {
        "description" : "The selected browse flow's rows for the picked parent.",
        "name" : "Browse items",
        "refresh_seconds" : 0,
        "run_when" : [
          "browse",
          "browse_parent"
        ],
        "sql" : {
          "query" : "SELECT * FROM construct_stream_rows(provider := '$provider_id$', stream := '$browse.id$', param := '$browse.child_param$', value := '$browse_parent$')"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5ec7105e0d5c0000000000a000000040",
      "query" : {
        "name" : "Streams",
        "query" : {
          "method" : "GET"
        },
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT * FROM construct_streams WHERE provider = '$provider_id$' AND listed = 1 ORDER BY entry DESC, name COLLATE NOCASE"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5ec7105e0d5c0000000000a000000042",
      "query" : {
        "name" : "Stream opens dashboards",
        "query" : {
          "method" : "GET"
        },
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT 'Rows of this stream open as dashboards — select a result row, then **Open**.' AS md FROM construct_streams WHERE provider = '$provider_id$' AND id = '$stream$' AND open_dashboard = 1"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5ec7105e0d5c0000000000a000000043",
      "query" : {
        "name" : "Stream fields",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT * FROM construct_stream_fields WHERE provider = '$provider_id$' AND stream = '$stream$'"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5ec7105e0d5c0000000000a000000044",
      "query" : {
        "description" : "Runs the selected stream with the Form's args (on Run).",
        "name" : "Results",
        "refresh_seconds" : 0,
        "run_when" : "form.__submitted",
        "sql" : {
          "query" : "SELECT * FROM construct_stream_rows(provider := '$provider_id$', stream := '$stream$', args := '$form.__args$')"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5ec7105e0d5c0000000000a000000045",
      "query" : {
        "name" : "Child streams",
        "query" : {
          "method" : "GET"
        },
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT * FROM construct_streams WHERE provider = '$provider_id$' AND parent = '$stream$' ORDER BY name COLLATE NOCASE"
        },
        "type" : "ds.sql"
      }
    }
  ],
