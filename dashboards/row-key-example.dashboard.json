      "query" : {
        "name" : "Perf by datasource (GROUP BY)",
        "refresh_seconds" : 30,
        "sql" : {
          "query" : "SELECT datasource, provider, SUM(fetches) AS fetches, SUM(errors) AS errors, MAX(max_ms) AS max_ms FROM construct_perf GROUP BY datasource, provider"
        },
        "type" : "ds.sql"
      }
    },
