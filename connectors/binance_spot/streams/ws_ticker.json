  "format" : "json",
  "id" : "ws_ticker",
  "method" : "GET",
  "name" : "ticker",
  "path" : "\/ws_ticker",
  "streaming" : {
    "endpoint" : "wss:\/\/stream.binance.com:9443\/ws",
    "keyCase" : "lower",
    "keyColumn" : "symbol",
    "keyTemplate" : "$key$@ticker",
    "keysParam" : "symbols",
    "retention" : {
      "rows" : 500
    },
    "rowKey" : [
      "s"
    ],
    "subscribe" : {
      "template" : "{\"method\":\"SUBSCRIBE\",\"params\":$keysJSON$,\"id\":1}"
    },
    "subscribeStatus" : {
      "errorValue" : "error",
      "event" : "subscribe-status",
      "failsPath" : "fails",
      "statusField" : "status"
    }
  },
  "transforms" : [
    {
      "rename" : {
        "fields" : {
          "p" : "priceChange"
        }
      }
    },
    {
      "coerceTypes" : {
        "fields" : {
          "askPrice" : "number",
