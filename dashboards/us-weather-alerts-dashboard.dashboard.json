        "name" : "Active Alerts",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT id, event, severity, status, headline FROM weather_gov_api.alerts_query WHERE status = 'Actual' ORDER BY effective DESC LIMIT 50"
