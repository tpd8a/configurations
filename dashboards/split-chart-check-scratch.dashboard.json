  "config_version" : 2,
  "data_sources" : [
    {
      "id" : "ds_8e2b4c6a1f3d4b5c9a7e6d5c4b3a2f10",
      "query" : {
        "name" : "errors_by_url_method",
        "refresh_seconds" : 300,
        "sql" : {
          "query" : "SELECT url, status, COUNT(*) AS hits FROM construct_examples.combined_access(path := 'web\/access.log') WHERE status >= 400 GROUP BY url, status"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_4f1a9c2e7b3d4e6a8c0f2b4d6e8a1c35",
      "query" : {
        "name" : "failures_404_500_by_url",
        "refresh_seconds" : 300,
        "sql" : {
          "query" : "SELECT url, SUM(CASE WHEN status = 404 THEN 1 ELSE 0 END) AS e404, SUM(CASE WHEN status = 500 THEN 1 ELSE 0 END) AS e500 FROM construct_examples.combined_access(path := 'web\/access.log') WHERE status IN (404, 500) GROUP BY url"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_b7c2e9f41a6d4c8e93f05a2d7e1b6c84",
      "query" : {
        "name" : "pct_failures_per_url",
        "refresh_seconds" : 300,
        "sql" : {
          "query" : "SELECT url, COUNT(*) AS total_failures, SUM(CASE WHEN status = 404 THEN 1 ELSE 0 END) AS count_404, SUM(CASE WHEN status = 500 THEN 1 ELSE 0 END) AS count_500, CAST(SUM(CASE WHEN status = 404 THEN 1 ELSE 0 END) * 100.0 \/ COUNT(*) AS INTEGER) AS pct_404 FROM construct_examples.combined_access(path := 'web\/access.log') WHERE status >= 400 GROUP BY url ORDER BY pct_404 DESC"
        },
        "type" : "ds.sql"
      }
    },
    {
      "connector_stream" : "combined_access",
      "id" : "ds_7e3a1c9b5d2f4e8a9c0b1d2e3f4a5b6c",
