    {
      "id" : "ds_afee393099b9417e988bc4b1c6531986",
      "query" : {
        "name" : "Severity Counts",
        "query" : {
          "method" : "GET"
        },
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT severity, COUNT(*) as cnt FROM weather.alerts_active GROUP BY severity ORDER BY cnt DESC"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_52743a7f55ff4df28114bb092a5838a9",
      "query" : {
        "name" : "Category and Severity Counts",
        "query" : {
          "method" : "GET"
        },
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT category, severity, COUNT(*) as cnt FROM weather.alerts_active GROUP BY category, severity ORDER BY cnt DESC LIMIT 15"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_72d26a5235ba47cd85bdabd22bb81135",
      "query" : {
        "name" : "Top Alert Areas",
        "query" : {
          "method" : "GET"
        },
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT areaDesc, COUNT(*) as cnt FROM weather.alerts_active GROUP BY areaDesc ORDER BY cnt DESC LIMIT 15"
        },
        "type" : "ds.sql"
      }
    }
  ],
