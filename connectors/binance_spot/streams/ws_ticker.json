          "volume" : "number"
        }
      }
    }
  ],
  "transport" : "webSocket",
  "userParams" : [
    {
      "key" : "symbols",
      "label" : "Symbols (comma-separated)",
      "location" : "query",
      "required" : true,
      "role" : "value"
