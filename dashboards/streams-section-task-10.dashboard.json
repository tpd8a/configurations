{
  "config_version" : 2,
  "data_sources" : [
    {
      "id" : "ds_5ec7105e0d5c0000000000a000000046",
      "query" : {
        "name" : "Providers",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT id AS value, name AS label FROM construct_providers WHERE enabled = 1 ORDER BY name"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5ec7105e0d5c0000000000a000000040",
      "query" : {
        "name" : "Streams",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT * FROM construct_streams WHERE provider = '$provider_id$' AND listed = 1 ORDER BY entry DESC, name COLLATE NOCASE"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5ec7105e0d5c0000000000a000000041",
      "query" : {
        "name" : "Stream header",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT '## ' || name || char(10) || char(10) || '`' || method || '`  ' || path || char(10) || char(10) || COALESCE(description, '') AS md FROM construct_streams WHERE provider = '$provider_id$' AND id = '$stream$'"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5ec7105e0d5c0000000000a000000042",
      "query" : {
        "name" : "Stream opens dashboards",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT 'Rows of this stream open as dashboards — select a result row, then **Open**.' AS md FROM construct_streams WHERE provider = '$provider_id$' AND id = '$stream$' AND open_dashboard = 1"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5ec7105e0d5c0000000000a000000043",
      "query" : {
        "name" : "Stream fields",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT * FROM construct_stream_fields WHERE provider = '$provider_id$' AND stream = '$stream$'"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5ec7105e0d5c0000000000a000000044",
      "query" : {
        "description" : "Runs the selected stream with the Form's args (on Run).",
        "name" : "Results",
        "refresh_seconds" : 0,
        "run_when" : "form.__submitted",
        "sql" : {
          "query" : "SELECT * FROM construct_stream_rows(provider := '$provider_id$', stream := '$stream$', args := '$form.__args$')"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_5ec7105e0d5c0000000000a000000045",
      "query" : {
        "name" : "Child streams",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT * FROM construct_streams WHERE provider = '$provider_id$' AND parent = '$stream$' ORDER BY name COLLATE NOCASE"
        },
        "type" : "ds.sql"
      }
    }
  ],
