      "properties": {
        "strokeColor": { "value": "#1e3a5f" },
        "label": { "value": "Workers" }
      }
    },
    {
      "id": "box_gateway",
      "spriteType": "gateway",
      "placement": "static",
      "x": 120, "y": 420, "w": 80, "h": 80,
      "properties": {
        "color": { "value": "#06b6d4" },
        "label": { "value": "LB" }
      }
    },
    {
      "id": "box_frontend",
      "spriteType": "rounded_rect",
      "placement": "static",
      "x": 310, "y": 200, "w": 240, "h": 250,
      "properties": {
        "color": { "value": "#0f2847" },
        "strokeColor": { "value": "#2563eb" },
        "label": { "value": "Frontend / BFF" }
      }
    },
    {
      "id": "box_api",
      "spriteType": "rounded_rect",
