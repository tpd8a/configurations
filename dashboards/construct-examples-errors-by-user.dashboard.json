  "data_sources" : [
    {
      "id" : "ds_5c1e0a7d9b2f4e6a8c3d1f0b7e9a2c41",
      "query" : {
        "name" : "users",
        "refresh_seconds" : 300,
        "sql" : {
          "query" : "SELECT DISTINCT user FROM construct_examples.app_events() ORDER BY user"
        },
        "time_mode" : {
          "mode" : "none"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_8a3f2b6c1d4e4f5a9b7c0d2e3f4a5b61",
      "query" : {
        "name" : "total_errors",
        "refresh_seconds" : 60,
        "sql" : {
          "query" : "SELECT COUNT(*) AS errors FROM construct_examples.app_events() WHERE level = 'ERROR' AND $users$"
        },
        "time_mode" : {
          "mode" : "none"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_2d7e9f1a3b5c4d6e8f0a1b2c3d4e5f72",
      "query" : {
        "name" : "errors_by_user",
        "refresh_seconds" : 60,
        "sql" : {
          "query" : "SELECT user, COUNT(*) AS errors FROM construct_examples.app_events() WHERE level = 'ERROR' AND $users$ GROUP BY user ORDER BY errors DESC"
        },
        "time_mode" : {
          "mode" : "none"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_6b4c8d0e2f1a4b3c9d5e7f6a8b0c1d83",
      "query" : {
        "name" : "errors_by_action",
        "refresh_seconds" : 60,
        "sql" : {
          "query" : "SELECT action, COUNT(*) AS errors, AVG(latency_ms) AS avg_latency_ms FROM construct_examples.app_events() WHERE level = 'ERROR' AND user LIKE '$user$' GROUP BY action ORDER BY errors DESC"
        },
        "time_mode" : {
          "mode" : "none"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_9e1f3a5b7c2d4e8f0a6b1c3d5e7f9a04",
      "query" : {
        "name" : "recent_errors",
        "refresh_seconds" : 60,
        "sql" : {
          "query" : "SELECT ts, user, action, ctx_region, ctx_version, latency_ms FROM construct_examples.app_events() WHERE level = 'ERROR' AND user LIKE '$user$' ORDER BY ts DESC LIMIT 50"
        },
        "time_mode" : {
          "mode" : "none"
        },
        "type" : "ds.sql"
      }
    }
  ],
