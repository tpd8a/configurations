{
  "name": "K8s Schematic",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "background": { "color": "#0a0e1a" }
  },
  "hud": [
    { "type": "label", "text": "K8s Cluster — Service Schematic", "position": "top_center" },
    { "type": "label", "text": "Ingress → Frontend → API → Data → Workers", "position": "bottom_left" },
    { "type": "label", "text": "LIVE", "position": "top_right" }
  ],
  "spriteBindings": [
    {
      "id": "tier_ingress",
      "spriteType": "dashed_rect",
      "placement": "static",
      "x": 40, "y": 80, "w": 200, "h": 900,
      "properties": {
        "strokeColor": { "value": "#1e3a5f" },
        "label": { "value": "Ingress" }
      }
    },
    {
      "id": "tier_frontend",
      "spriteType": "dashed_rect",
      "placement": "static",
      "x": 280, "y": 80, "w": 300, "h": 900,
      "properties": {
        "strokeColor": { "value": "#1e3a5f" },
        "label": { "value": "Frontend" }
      }
    },
    {
      "id": "tier_services",
      "spriteType": "dashed_rect",
      "placement": "static",
      "x": 620, "y": 80, "w": 500, "h": 900,
      "properties": {
        "strokeColor": { "value": "#1e3a5f" },
        "label": { "value": "Services" }
      }
    },
    {
      "id": "tier_data",
      "spriteType": "dashed_rect",
      "placement": "static",
      "x": 1160, "y": 80, "w": 400, "h": 900,
      "properties": {
        "strokeColor": { "value": "#1e3a5f" },
        "label": { "value": "Data" }
      }
    },
    {
      "id": "tier_workers",
      "spriteType": "dashed_rect",
