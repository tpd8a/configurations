      "id" : "ds_4c1e9a7b2d3f4e5a8b6c0d1e2f3a4b5c",
      "query" : {
        "name" : "failures_by_path",
        "refresh_seconds" : 300,
        "sql" : {
          "query" : "SELECT url, SUM(CASE WHEN status = 404 THEN 1 ELSE 0 END) AS e404, SUM(CASE WHEN status = 500 THEN 1 ELSE 0 END) AS e500, COUNT(*) AS requests, SUM(CASE WHEN status = 404 OR status = 500 THEN 1 ELSE 0 END) * 100.0 \/ COUNT(*) AS pct_failed FROM construct_examples.combined_access(path := 'bench\/access.log') GROUP BY url ORDER BY pct_failed DESC"
        },
        "time_mode" : {
          "mode" : "none"
        },
        "type" : "ds.sql"
      }
    }
  ],
