    {
      "id" : "ds_61affde11a4b4d70a0ef29cc0e64a67e",
      "query" : {
        "name" : "timeline wrap=true",
        "refresh_seconds" : 120,
        "sql" : {
          "query" : "SELECT * FROM splunk_enterprise_rest_api.search_job_flow(query := 'index=_internal | stats latest(_time) as _time count by sourcetype|  eval _time=now()\n| table count sourcetype\n| eval count=(count%100)', namespace := 'search')"
        },
        "time_mode" : {
          "earliest" : "$earliest_tok$",
          "latest" : "now",
          "mode" : "fixed"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_582eeefd740d4b8daa16c00c8e500cd6",
      "query" : {
        "name" : "wrap=true",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT * FROM splunk_enterprise_rest_api.search_job_flow(query := 'index=\"_internal\" source=* \n| stats latest(_time) as _time count count(eval(match(_raw,\"INFO\"))) as info  count(eval(match(_raw,\"ERROR\"))) as error count(eval(match(_raw,\"WARN\"))) as warn by source host | sort - error |  head 4 |  eval _time=now()', namespace := 'search')"
        },
        "time_mode" : {
          "earliest" : "$earliest_tok$",
          "latest" : "now",
          "mode" : "fixed"
        },
        "type" : "ds.sql"
      }
    },
