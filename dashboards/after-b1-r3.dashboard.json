{
  "config_version" : 2,
  "data_sources" : [
    {
      "id" : "ds_4a1c9e2b7d3f4e5a8b6c0d1e2f3a4b5c",
      "query" : {
        "name" : "failures_by_path",
        "query" : {
          "method" : "GET"
        },
        "refresh_seconds" : 300,
        "sql" : {
          "query" : "SELECT url, CASE WHEN '$status_class$' = '5xx' THEN NULL ELSE SUM(CASE WHEN status = 404 THEN 1 ELSE 0 END) END AS e404, CASE WHEN '$status_class$' = '4xx' THEN NULL ELSE SUM(CASE WHEN status = 500 THEN 1 ELSE 0 END) END AS e500, SUM(CASE WHEN (status >= 400 AND status < 500 AND '$status_class$' <> '5xx') OR (status >= 500 AND '$status_class$' <> '4xx') THEN 1 ELSE 0 END) * 100.0 \/ COUNT(*) AS pct_failed, COUNT(*) AS requests FROM construct_examples.combined_access(path := 'bench\/access.log') GROUP BY url ORDER BY pct_failed DESC"
        },
        "time_mode" : {
          "mode" : "none"
        },
        "type" : "ds.sql"
      }
    }
  ],
  "description" : "404 \/ 500 failures per request path from construct_examples bench\/access.log",
