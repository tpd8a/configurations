    {
      "id" : "ds_5a1d24f0c0de4b7e9e2a4d1b6c3f0e24",
      "query" : {
        "name" : "ds_5a1d24f0c0de4b7e9e2a4d1b6c3f0e24",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "WITH t AS (SELECT * FROM ticker_24hr WHERE symbol = '$row.symbol$')\nSELECT 'Last price' AS label, printf('%.8g', lastPrice) AS value, 'tag' AS icon FROM t\nUNION ALL SELECT '24h change', printf('%+.2f%%', priceChangePercent), CASE WHEN priceChangePercent >= 0 THEN 'arrow.up.right' ELSE 'arrow.down.right' END FROM t\nUNION ALL SELECT '24h high \/ low', printf('%.8g \/ %.8g', highPrice, lowPrice), 'arrow.up.and.down' FROM t\nUNION ALL SELECT '24h volume', printf('%,d', CAST(volume AS INTEGER)), 'chart.bar' FROM t\nUNION ALL SELECT 'Trades', CAST(count AS TEXT), 'number' FROM t"
        },
        "type" : "ds.sql"
      }
    }
  ],
