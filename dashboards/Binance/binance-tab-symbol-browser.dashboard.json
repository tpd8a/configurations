    {
      "id" : "ds_90563ccc0fe1f66d6f5af3a1c03b6d1b",
      "query" : {
        "name" : "viz_binance",
        "query" : {
          "method" : "GET"
        },
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "select time, symbol, priceChange, priceChangePercent, askPrice, askQuantity, bid, bidQuantity, open, high, low, close, volume  from binance_spot.ws_ticker"
        },
