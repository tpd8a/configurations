        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT status, COUNT(*) AS hits FROM construct_examples.combined_access(path := 'web\/access.log') GROUP BY status ORDER BY hits DESC"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_acfd4ff12230478484282b36d554e41c",
      "query" : {
        "name" : "ds_acfd4ff12230478484282b36d554e41c",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT url, status, COUNT(*) AS hits FROM construct_examples.combined_access(path := 'web\/access.log') WHERE status >= 400 GROUP BY url, status ORDER BY hits DESC LIMIT 10"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_e148214577bf43ad8237cbeb38893b41",
      "query" : {
        "name" : "ds_e148214577bf43ad8237cbeb38893b41",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT client, COUNT(*) AS hits, SUM(bytes) AS bytes FROM construct_examples.combined_access(path := 'web\/access.log') GROUP BY client ORDER BY hits DESC"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_bf1e8a44f8114b27b07fc2d4adc4fa65",
