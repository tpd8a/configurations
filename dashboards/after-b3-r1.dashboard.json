{
  "config_version" : 2,
  "data_sources" : [
    {
      "id" : "ds_a1b2c3d4e5f60718293a4b5c6d7e8f90",
      "query" : {
        "name" : "actions_by_user",
        "refresh_seconds" : 300,
        "sql" : {
          "query" : "SELECT regexp_extract(_raw, '\"user\": \"([^\"]+)\"', ARRAY['usr']) AS usr, SUM(CASE WHEN _raw LIKE '%\"action\": \"login\"%' THEN 1 ELSE 0 END) AS login, SUM(CASE WHEN _raw LIKE '%\"action\": \"logout\"%' THEN 1 ELSE 0 END) AS logout, SUM(CASE WHEN _raw LIKE '%\"action\": \"purchase\"%' THEN 1 ELSE 0 END) AS purchase, SUM(CASE WHEN _raw LIKE '%\"action\": \"search\"%' THEN 1 ELSE 0 END) AS search, SUM(CASE WHEN _raw LIKE '%\"action\": \"view\"%' THEN 1 ELSE 0 END) AS views FROM construct_examples.lines(path := 'bench\/events.jsonl') WHERE _raw LIKE '%\"region\": \"$region$\"%' GROUP BY usr"
        },
        "time_mode" : {
          "mode" : "none"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_0f1e2d3c4b5a69788796a5b4c3d2e1f0",
      "query" : {
        "name" : "user_events",
        "refresh_seconds" : 300,
        "sql" : {
          "query" : "SELECT regexp_extract(_raw, '\"ts\": \"([^\"]+)\".*\"level\": \"([^\"]+)\", \"user\": \"([^\"]+)\", \"action\": \"([^\"]+)\", \"latency_ms\": ([0-9.]+).*\"region\": \"([^\"]+)\", \"version\": \"([^\"]+)\"', ARRAY['ts','level','usr','act','lat','region','version']) AS x, ts, usr, act, level, CAST(lat AS INTEGER) AS latency_ms, region, version FROM construct_examples.lines(path := 'bench\/events.jsonl') WHERE _raw LIKE '%\"user\": \"$user$\"%' AND _raw LIKE '%\"region\": \"$region$\"%' ORDER BY latency_ms DESC"
        },
        "time_mode" : {
          "mode" : "none"
        },
        "type" : "ds.sql"
      }
    }
  ],
