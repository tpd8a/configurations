{
  "config_version" : 2,
  "data_sources" : [
    {
      "id" : "ds_7c1e2a9b4f3d4e6a8b0c1d2e3f4a5b6c",
      "query" : {
        "name" : "failures_by_path",
        "refresh_seconds" : 300,
        "sql" : {
          "query" : "SELECT url, SUM(CASE WHEN status = 404 AND ('$status_class$' = '4xx' OR '$status_class$' = '*') THEN 1 ELSE 0 END) AS e404, SUM(CASE WHEN status = 500 AND ('$status_class$' = '5xx' OR '$status_class$' = '*') THEN 1 ELSE 0 END) AS e500, COUNT(*) AS requests, SUM(CASE WHEN (status >= 400 AND status < 500 AND ('$status_class$' = '4xx' OR '$status_class$' = '*')) OR (status >= 500 AND status < 600 AND ('$status_class$' = '5xx' OR '$status_class$' = '*')) THEN 1 ELSE 0 END) * 100.0 \/ COUNT(*) AS pct_failed FROM construct_examples.combined_access(path := 'bench\/access.log') GROUP BY url ORDER BY pct_failed DESC"
        },
        "time_mode" : {
          "mode" : "none"
        },
        "type" : "ds.sql"
      }
    }
  ],
  "description" : "404 \/ 500 counts and % failed per request path from bench\/access.log (construct_examples files root), filterable by status class.",
