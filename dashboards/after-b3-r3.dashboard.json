  "data_sources" : [
    {
      "id" : "ds_4a1c7e2b9d3f4e5a8b6c0d1e2f3a4b5c",
      "query" : {
        "name" : "actions_by_user",
        "refresh_seconds" : 300,
        "sql" : {
          "query" : "SELECT user, SUM(CASE WHEN action = 'login' THEN 1 ELSE 0 END) AS login, SUM(CASE WHEN action = 'view' THEN 1 ELSE 0 END) AS view, SUM(CASE WHEN action = 'search' THEN 1 ELSE 0 END) AS search, SUM(CASE WHEN action = 'purchase' THEN 1 ELSE 0 END) AS purchase, SUM(CASE WHEN action = 'logout' THEN 1 ELSE 0 END) AS logout FROM construct_examples.jsonl(path := 'bench\/events.jsonl') WHERE ctx LIKE '%\"region\":\"$region$\"%' GROUP BY user"
        },
        "time_mode" : {
          "mode" : "none"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_9b8e7d6c5a4f43b2a1c0e9d8f7b6a5c4",
      "query" : {
        "name" : "events_for_user",
        "refresh_seconds" : 300,
        "sql" : {
          "query" : "SELECT ts, user, action, level, latency_ms, ctx FROM construct_examples.jsonl(path := 'bench\/events.jsonl') WHERE user = '$pick_user$' AND ctx LIKE '%\"region\":\"$region$\"%' ORDER BY latency_ms DESC"
        },
        "time_mode" : {
          "mode" : "none"
        },
        "type" : "ds.sql"
      }
    }
  ],
