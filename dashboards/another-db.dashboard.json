        "sql" : {
          "query" : "SELECT * FROM splunk_enterprise_rest_api.search_job_flow(query := 'index=\"_internal\" source=*| stats latest(_time) as _time count count(eval(match(_raw,\"INFO\"))) as info  count(eval(match(_raw,\"ERROR\"))) as error count(eval(match(_raw,\"WARN\"))) as warn by source host | sort - error |  head 4 |  eval _time=now()', namespace := 'search')"
