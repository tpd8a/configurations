  "data_sources" : [
    {
      "id" : "ds_7c1e4a9b2d3f4e5a8b6c0d1e2f3a4b5c",
      "query" : {
        "name" : "failures_by_path",
        "refresh_seconds" : 300,
        "sql" : {
          "query" : "SELECT url AS req_path, SUM(CASE WHEN status = 404 AND ('$status_class$' = '*' OR CAST(status \/ 100 AS TEXT) || 'xx' = '$status_class$') THEN 1 ELSE 0 END) AS count_404, SUM(CASE WHEN status = 500 AND ('$status_class$' = '*' OR CAST(status \/ 100 AS TEXT) || 'xx' = '$status_class$') THEN 1 ELSE 0 END) AS count_500, COUNT(*) AS requests, SUM(CASE WHEN status >= 400 AND ('$status_class$' = '*' OR CAST(status \/ 100 AS TEXT) || 'xx' = '$status_class$') THEN 1 ELSE 0 END) * 100.0 \/ COUNT(*) AS pct_failed FROM construct_examples.combined_access(path := 'bench\/access.log') GROUP BY url ORDER BY pct_failed DESC"
        },
        "time_mode" : {
          "mode" : "none"
        },
        "type" : "ds.sql"
      }
    }
  ],
  "description" : "404 \/ 500 counts and % failed per request path from construct_examples bench\/access.log",
