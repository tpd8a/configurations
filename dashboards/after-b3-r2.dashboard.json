{
  "config_version" : 2,
  "data_sources" : [
    {
      "id" : "ds_7c1a2e4b9d3f4a5e8b6c0d1e2f3a4b51",
      "query" : {
        "name" : "actions_by_user",
        "refresh_seconds" : 300,
        "sql" : {
          "query" : "SELECT user, SUM(CASE WHEN action = 'login' THEN 1 ELSE 0 END) AS login, SUM(CASE WHEN action = 'logout' THEN 1 ELSE 0 END) AS logout, SUM(CASE WHEN action = 'purchase' THEN 1 ELSE 0 END) AS purchase, SUM(CASE WHEN action = 'search' THEN 1 ELSE 0 END) AS search, SUM(CASE WHEN action = 'view' THEN 1 ELSE 0 END) AS view FROM construct_examples.app_events(path := 'bench\/events.jsonl') WHERE (ctx_region IN ($region$) OR '$form.region$' = '*') GROUP BY user ORDER BY user"
        },
        "time_mode" : {
          "mode" : "none"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_8d2b3f5c0e4a4b6f9c7d1e2f3a4b5c62",
      "query" : {
        "name" : "events_for_user",
        "refresh_seconds" : 300,
        "sql" : {
          "query" : "SELECT ts, user, action, latency_ms, level, ctx_region FROM construct_examples.app_events(path := 'bench\/events.jsonl') WHERE user = '$pick_user$' AND (ctx_region IN ($region$) OR '$form.region$' = '*') ORDER BY latency_ms DESC"
        },
        "time_mode" : {
          "mode" : "none"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_e58b9fbc6e0a4bcfd17d8e9fa0b1c2c8",
      "query" : {
        "name" : "region_choices",
        "refresh_seconds" : 300,
        "sql" : {
          "query" : "SELECT DISTINCT ctx_region FROM construct_examples.app_events(path := 'bench\/events.jsonl')"
        },
        "time_mode" : {
          "mode" : "none"
        },
        "type" : "ds.sql"
      }
    }
  ],
