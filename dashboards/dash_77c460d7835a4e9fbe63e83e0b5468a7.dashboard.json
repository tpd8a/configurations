              "id" : "viz_b74463b5e78f4961a851af2140c070a8",
              "layer" : 1,
              "sql_composition" : "SELECT dashboard,\n    SUM(fetches) AS total_fetches,\n    SUM(errors) AS total_errors,\n    CASE WHEN SUM(fetches)>0 THEN ROUND(100.0*SUM(errors)\/NULLIF(SUM(fetches),0),2) END AS error_rate_pct,\n    AVG(avg_ms) AS avg_latency_ms,\n    MAX(max_ms) AS max_latency_ms\nFROM construct_perf\nWHERE window_start > unixepoch('now','-1 day')\nGROUP BY dashboard\nORDER BY total_fetches DESC;",
              "type" : "table",
              "width" : 12
            }
          ]
