      "x": 660, "y": 150, "w": 240, "h": 280,
      "properties": {
        "color": { "value": "#0f2847" },
        "strokeColor": { "value": "#2563eb" },
        "label": { "value": "API Services" }
      }
    },
    {
      "id": "box_auth",
      "spriteType": "rounded_rect",
      "placement": "static",
      "x": 660, "y": 530, "w": 240, "h": 250,
      "properties": {
        "color": { "value": "#0f2847" },
        "strokeColor": { "value": "#2563eb" },
        "label": { "value": "Auth" }
      }
    },
    {
      "id": "box_db",
      "spriteType": "rounded_rect",
      "placement": "static",
      "x": 1200, "y": 150, "w": 200, "h": 220,
      "properties": {
        "color": { "value": "#1a1408" },
        "strokeColor": { "value": "#d97706" },
        "label": { "value": "Database" }
      }
    },
    {
      "id": "box_cache",
      "spriteType": "rounded_rect",
      "placement": "static",
      "x": 1200, "y": 430, "w": 200, "h": 200,
      "properties": {
        "color": { "value": "#1a0808" },
        "strokeColor": { "value": "#dc2626" },
        "label": { "value": "Cache" }
      }
    },
    {
      "id": "box_queue",
      "spriteType": "rounded_rect",
      "placement": "static",
      "x": 1200, "y": 690, "w": 200, "h": 200,
      "properties": {
        "color": { "value": "#14081a" },
        "strokeColor": { "value": "#9333ea" },
        "label": { "value": "Queue" }
      }
    },
    {
      "id": "box_workers",
      "spriteType": "rounded_rect",
      "placement": "static",
      "x": 1630, "y": 250, "w": 220, "h": 350,
      "properties": {
        "color": { "value": "#0f2847" },
        "strokeColor": { "value": "#2563eb" },
        "label": { "value": "Workers / Cron" }
      }
    },
    {
      "id": "service_connections",
      "datasourceId": "ds_connections",
      "entityField": "edge_id",
      "spriteType": "connection",
      "placement": "edge",
      "sourceField": "box_source",
      "targetField": "box_target",
      "sourceAnchor": "out",
      "targetAnchor": "in",
      "connectionStyle": "junction",
      "properties": {
        "color": { "field": "status", "map": { "active": "#3b82f6", "degraded": "#f97316" } },
        "opacity": { "field": "bytes_sec", "range": [0.3, 1.0], "inputRange": [0, 50000] }
      },
      "trafficDots": {
        "count": 2,
        "radius": 3,
        "speedField": "bytes_sec",
        "speedRange": [80.0, 0.8],
        "colorField": "status",
        "colorMap": { "active": "#60a5fa", "degraded": "#fb923c" }
      }
    },
    {
      "id": "scorecard_ingress",
      "datasourceId": "ds_fleet",
      "spriteType": "scorecard",
      "placement": "static",
      "x": 60, "y": 550, "w": 180, "h": 80,
      "scorecard": {
        "groupField": "role",
        "groupValue": "ingress",
        "groupValues": ["ingress", "nginx"],
        "countField": "hostname",
        "breakdownField": "status",
        "format": "{total} pods\nCPU {avg:cpu_percent}%\n{breakdown}"
      }
    },
    {
      "id": "scorecard_frontend",
      "datasourceId": "ds_fleet",
