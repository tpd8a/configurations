        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT severity, COUNT(*) as count FROM weather_gov_api.alerts_query WHERE status = 'Actual' GROUP BY severity ORDER BY count DESC LIMIT 10"
