      "query" : {
        "name" : "table wrap=true",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT * FROM splunk_enterprise_rest_api.search_job_flow(query := '| tstats count where index=* OR index=_* by _time index source span=10m\n| search $text_tok$ |  eval _time=now()', namespace := 'search')"
