  "data_sources" : [
    {
      "id" : "ds_83486c3201944e58a298b8109b767514",
      "query" : {
        "name" : "Total Active Alerts Count",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT COUNT(*) as total FROM weather.alerts_active WHERE status = 'Actual' LIMIT 1"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_a71fd82341cd4c24b89ed2e4f9d4f712",
      "query" : {
        "name" : "Alerts by Severity",
        "query" : {
          "method" : "GET"
        },
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT severity, COUNT(*) as count FROM weather.alerts_active WHERE status = 'Actual' GROUP BY severity ORDER BY count DESC LIMIT 20"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_d0bd77fa5fef4df0b95dfd2106e4c6fd",
      "query" : {
        "name" : "Top Alert Areas",
        "query" : {
          "method" : "GET"
        },
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT areaDesc, COUNT(*) as count FROM weather.alerts_active WHERE status = 'Actual' GROUP BY areaDesc ORDER BY count DESC LIMIT 15"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_a36bd72cca3646808126b165a897fb83",
      "query" : {
        "name" : "Alerts by Event Type",
        "query" : {
          "method" : "GET"
        },
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT event, COUNT(*) as count FROM weather.alerts_active WHERE status = 'Actual' GROUP BY event ORDER BY count DESC LIMIT 15"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_0c62fe6a837c485ab5c118466de5e15d",
      "query" : {
        "name" : "Recent Active Alerts Details",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT id, event, severity, status, areaDesc, headline FROM weather.alerts_active WHERE status = 'Actual' ORDER BY effective DESC LIMIT 10"
        },
        "type" : "ds.sql"
      }
    }
  ],
