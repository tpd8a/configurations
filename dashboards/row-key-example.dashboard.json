      "query" : {
        "name" : "Perf windows (no GROUP BY)",
        "query" : {
          "method" : "GET"
        },
        "refresh_seconds" : 30,
        "sql" : {
          "query" : "SELECT window_start, datasource, provider, transport, fetches, errors FROM construct_perf ORDER BY window_start DESC LIMIT 50"
        },
        "type" : "ds.sql"
      }
    }
