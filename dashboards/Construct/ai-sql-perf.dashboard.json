      "id" : "ds_e995c8e6d178a2efc47fa850f92def8c",
      "query" : {
        "name" : "viz_b74463b5e78f4961a851af2140c070a8",
        "refresh_seconds" : 0,
        "sql" : {
          "query" : "SELECT dashboard,\n    SUM(fetches) AS total_fetches,\n    SUM(errors) AS total_errors,\n    CASE WHEN SUM(fetches)>0 THEN ROUND(100.0*SUM(errors)\/NULLIF(SUM(fetches),0),2) END AS error_rate_pct,\n    AVG(avg_ms) AS avg_latency_ms,\n    MAX(max_ms) AS max_latency_ms\nFROM construct_perf\nWHERE window_start > unixepoch('now','-2 day')\nGROUP BY dashboard\nORDER BY total_fetches DESC;"
        },
        "type" : "ds.sql"
      }
    },
    {
      "id" : "ds_e588544832cf13476620114a3a020e32",
      "query" : {
        "name" : "viz_1e373f438bb647699fd4635cb626efa4",
